<section class="dmv-notice" aria-label="Virginia DMV notice">
  <div class="container dmv-notice__inner">
    <a href="/images/dmv-certificate.jpg" class="dmv-notice__license-link" target="_blank" rel="noopener">
      <img class="dmv-notice__license" src="/images/dmv-certificate.jpg" alt="Facsimile of the Virginia DMV certificate licensing Premier Driver Improvement Clinic to operate a driver improvement clinic" loading="lazy" width="1280" height="782">
      <span class="dmv-notice__license-caption">Our DMV-issued certificate (click to enlarge)</span>
    </a>
    <div class="dmv-notice__body">
      <p class="dmv-notice__statement">If you have comments or concerns about this course, call the Department of Motor Vehicles at <a href="tel:{{ site.dmvPhoneTel }}">{{ site.dmvPhone }}</a> (toll-free).</p>
      <p class="dmv-notice__text">Premier Driver Improvement Clinic is licensed by the Virginia Department of Motor Vehicles to operate a driver improvement clinic. The DMV promotes transportation safety by certifying quality driver training programs.</p>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__contact">
      <span><strong>Help Desk:</strong> {{ site.helpDeskDays }}, {{ site.helpDeskHours }}</span>
      <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
    <div class="site-footer__inner">
      <div class="site-footer__links">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-use/">Terms of Service</a>
      </div>
      <p class="site-footer__copy">&copy; {{ site.copyright }}</p>
    </div>
  </div>
</footer>
