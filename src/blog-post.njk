---
layout: base.njk
title: Blog Post Template
permalink: false
---

{# This is a template for individual blog posts.
   When you add blog posts, create files in src/blog/ with this frontmatter:
   ---
   layout: base.njk
   title: Your Post Title
   date: 2026-04-01
   excerpt: A brief summary of the post.
   image: /images/your-image.avif
   tags: post
   ---
   Your post content here in HTML or Markdown.
#}

<section class="blog-post__header">
  <div class="container">
    <h1>{{ title }}</h1>
    {% if excerpt %}<p class="blog-post__excerpt">{{ excerpt }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container container--narrow">
    <article class="blog-post__content prose">
      {{ content | safe }}
    </article>
  </div>
</section>

<section class="section section--dark">
  <div class="container text-center">
    <h2>Need to complete a driver improvement course?</h2>
    <a href="/driver-improvement-course/" class="btn btn--primary">View the Course <svg class="btn__arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
  </div>
</section>
