---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.url and item.url != "/privacy-policy/" and item.url != "/terms-of-use/" and item.url != "/thank-you/" %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ item.date.toISOString().split('T')[0] }}</lastmod>
    {%- if item.url == "/" %}
    <priority>1.0</priority>
    {%- elif item.url == "/driver-improvement-course/" %}
    <priority>0.9</priority>
    {%- elif item.url == "/our-story/" or item.url == "/contact/" %}
    <priority>0.7</priority>
    {%- else %}
    <priority>0.6</priority>
    {%- endif %}
  </url>
{%- endif %}
{%- endfor %}
</urlset>
